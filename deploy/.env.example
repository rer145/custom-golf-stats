# Copy to deploy/.env on the server (chmod 600) and fill in. Never commit the real file.
# Every value below is a placeholder.

# --- Sites (Caddy) ---------------------------------------------------------------------------------------------------
# Public host names. DNS A/AAAA records for both must point at the server before the first start.
WEB_DOMAIN=stats.example.com
API_DOMAIN=api.stats.example.com
# Contact address for the Let's Encrypt account Caddy registers.
ACME_EMAIL=ops@example.com
# Host ports Caddy publishes (the only published ports in the stack).
HTTP_PORT=80
HTTPS_PORT=443

# --- Images ----------------------------------------------------------------------------------------------------------
# Required. The git SHA of the images built by .github/workflows/images.yml (the migrator is <API_IMAGE>:<IMAGE_TAG>-migrator).
# deploy.sh <tag> (run by remote-deploy.sh) sets it for each deploy, so keep this placeholder; for manual `docker compose` commands use `remote-deploy.sh compose ...`, which sets the deployed tag.
IMAGE_TAG=0000000000000000000000000000000000000000
API_IMAGE=ghcr.io/rer145/custom-golf-stats-api
WEB_IMAGE=ghcr.io/rer145/custom-golf-stats-web
# Postgres 17.11 + WAL-G, built from deploy/postgres (used as <POSTGRES_IMAGE>:<IMAGE_TAG>, like the two above).
POSTGRES_IMAGE=ghcr.io/rer145/custom-golf-stats-postgres

# Pinned third-party image (bump deliberately).
CADDY_IMAGE=caddy:2.11.9

# --- Postgres --------------------------------------------------------------------------------------------------------
# The API's ConnectionStrings:Postgres (ConnectionStrings__Postgres) is assembled from these in compose.yaml:
#   Host=postgres;Database=$POSTGRES_DB;Username=$POSTGRES_USER;Password=$POSTGRES_PASSWORD
# Use a password without ';' or quotes, e.g. `openssl rand -hex 32`.
POSTGRES_DB=custom_golf_stats
POSTGRES_USER=custom_golf_stats
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32

# --- Backups (WAL-G) -------------------------------------------------------------------------------------------------
# Continuous WAL archiving plus a nightly full base backup to S3-compatible storage. Setup for Backblaze B2 or AWS S3,
# restores and the drill: docs/deploy/backups.md. All required (BACKUP_TIME and WALG_RETAIN_FULL have defaults).
# Where backups go: s3://<bucket>/<path>. One prefix per database; never share it with another server.
WALG_S3_PREFIX=s3://your-backup-bucket/custom-golf-stats
# An access key limited to that bucket (B2: an application key restricted to the bucket; S3: an IAM user, see docs).
AWS_ACCESS_KEY_ID=your-key-id
AWS_SECRET_ACCESS_KEY=your-application-key
# The storage's S3 endpoint and region.
#   Backblaze B2: https://s3.<region>.backblazeb2.com and <region>, e.g. https://s3.us-west-004.backblazeb2.com / us-west-004
#   AWS S3:       https://s3.<region>.amazonaws.com and <region>, e.g. https://s3.eu-west-1.amazonaws.com / eu-west-1
AWS_ENDPOINT=https://s3.us-west-004.backblazeb2.com
AWS_REGION=us-west-004
# true for MinIO and other servers without virtual-host bucket addressing; false (the default) for B2 and AWS S3.
AWS_S3_FORCE_PATH_STYLE=false
# Nightly full base backup time, HH:MM in UTC.
BACKUP_TIME=03:00
# Full base backups kept; older ones, and the WAL only they needed, are deleted after each backup. Point-in-time restore
# reaches back to the oldest kept backup (7 nightly backups: about a week).
WALG_RETAIN_FULL=7

# --- API -------------------------------------------------------------------------------------------------------------
# GolfCourseApi:ApiKey (course search/import). Empty disables the provider calls.
GOLF_COURSE_API_KEY=your-golfcourseapi-key
# Weather:OpenMeteo:* (defaults are the free endpoints; a commercial plan sets its own URLs and key).
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_API_KEY=
# Auth:Apple:ClientIds and Auth:Google:ClientIds: comma-separated audiences accepted for external sign-in.
AUTH_APPLE_CLIENT_IDS=com.customgolfstats.app
AUTH_GOOGLE_CLIENT_IDS=000000000000-placeholder.apps.googleusercontent.com
# The Compose proxy network. The API trusts X-Forwarded-For/Proto only from it (ReverseProxy:KnownNetworks).
# Change only if it collides with another network on the server.
PROXY_SUBNET=172.30.0.0/24

# --- Web -------------------------------------------------------------------------------------------------------------
# SESSION_SECRET (runtime): at least 32 characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
SESSION_SECRET=change-me-at-least-32-characters-of-random-text
# API_BASE_URL (runtime) is fixed in compose.yaml to the internal http://api:8080.
# ALLOWED_HOSTS (build time) is not read here: it is baked into the web image by .github/workflows/images.yml from the
# repository variable WEB_ALLOWED_HOSTS (set it to WEB_DOMAIN). Listed for completeness:
# ALLOWED_HOSTS=stats.example.com
