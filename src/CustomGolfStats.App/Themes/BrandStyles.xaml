<!--
  Control styles for Custom Golf Stats (brand/BRAND.md section 5). Every colour, font, size and radius comes from the generated
  BrandTokens.xaml; nothing here is a raw value from the brand kit except layout choices the guide states (44 pt targets etc.).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- The colour mark and lockup are for light backgrounds. -->
      <BitmapImage x:Key="BrandMarkImage" UriSource="ms-appx:///Assets/Brand/mark-color-256.png" />
      <BitmapImage x:Key="BrandLockupStackedImage" UriSource="ms-appx:///Assets/Brand/lockup-stacked-on-light@2x.png" />
      <!-- WinUI defaults that pages and controls fall back to. -->
      <StaticResource x:Key="ApplicationPageBackgroundThemeBrush" ResourceKey="BrandBackgroundBrush" />
      <!-- Focused inputs underline in the brand primary instead of the system accent. -->
      <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="BrandPrimaryBrush" />
      <!-- Cards: 1 px border on light. -->
      <StaticResource x:Key="BrandCardBorderBrush" ResourceKey="BrandBorderBrush" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <!-- The reversed mark and on-dark lockup are for Fairway Ink backgrounds. -->
      <BitmapImage x:Key="BrandMarkImage" UriSource="ms-appx:///Assets/Brand/mark-reversed-256.png" />
      <BitmapImage x:Key="BrandLockupStackedImage" UriSource="ms-appx:///Assets/Brand/lockup-stacked-on-dark@2x.png" />
      <StaticResource x:Key="ApplicationPageBackgroundThemeBrush" ResourceKey="BrandBackgroundBrush" />
      <!-- Cards: no border on dark (BRAND.md section 5). -->
      <SolidColorBrush x:Key="BrandCardBorderBrush" Color="Transparent" />
      <!-- Focused inputs underline in the brand primary instead of the system accent. -->
      <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="BrandPrimaryBrush" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Screen padding is 20 on mobile. -->
  <Thickness x:Key="BrandScreenPadding">20,16,20,24</Thickness>

  <!-- ===== Pages ===== -->
  <Style x:Key="BrandPageStyle" TargetType="Page">
    <Setter Property="Background" Value="{ThemeResource BrandBackgroundBrush}" />
  </Style>

  <!-- ===== Text ===== -->
  <Style x:Key="BrandTextSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource BrandTextBodyStyle}">
    <Setter Property="Foreground" Value="{ThemeResource BrandTextSecondaryBrush}" />
  </Style>
  <Style x:Key="BrandTextCaptionSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource BrandTextCaptionStyle}">
    <Setter Property="Foreground" Value="{ThemeResource BrandTextSecondaryBrush}" />
  </Style>
  <!-- Errors read in the negative colour (Pin Deep on light, accent text on dark), never Pin Orange on light. -->
  <Style x:Key="BrandTextErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource BrandTextCaptionStyle}">
    <Setter Property="Foreground" Value="{ThemeResource BrandNegativeBrush}" />
  </Style>

  <!-- ===== Buttons (44 tall, radius sm) ===== -->
  <Style x:Key="BrandButtonBaseStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="{StaticResource BrandButtonHeight}" />
    <Setter Property="MinWidth" Value="{StaticResource BrandTouchTarget}" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{StaticResource BrandRadiusSm}" />
    <Setter Property="FontFamily" Value="{StaticResource BrandFontBodySemiBold}" />
    <Setter Property="FontSize" Value="{StaticResource BrandFontSizeMd}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Primary: Fairway background, white text (dark: Chalk background, Ink text). -->
  <Style x:Key="BrandPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BrandButtonBaseStyle}">
    <Setter Property="Background" Value="{ThemeResource BrandPrimaryBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource BrandOnPrimaryBrush}" />
  </Style>

  <!-- Accent: Pin Orange with Cup text. Only for "add" actions. -->
  <Style x:Key="BrandAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BrandButtonBaseStyle}">
    <Setter Property="Background" Value="{ThemeResource BrandAccentBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource BrandOnAccentBrush}" />
  </Style>

  <!-- Secondary: transparent with a 1 px border. -->
  <Style x:Key="BrandSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BrandButtonBaseStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource BrandTextBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BrandBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource BrandBorderThickness}" />
  </Style>

  <!-- Hero call to action: 52 tall. -->
  <Style x:Key="BrandHeroButtonStyle" TargetType="Button" BasedOn="{StaticResource BrandPrimaryButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource BrandButtonHeightLarge}" />
  </Style>

  <!-- Text-only button (links such as "Create an account"), still a 44 pt target. -->
  <Style x:Key="BrandLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource BrandButtonBaseStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource BrandPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource BrandFontBodyMedium}" />
  </Style>

  <!-- ===== Inputs (44 tall, radius sm) ===== -->
  <Style x:Key="BrandTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="MinHeight" Value="{StaticResource BrandInputHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource BrandRadiusSm}" />
    <Setter Property="FontFamily" Value="{StaticResource BrandFontBody}" />
    <Setter Property="FontSize" Value="{StaticResource BrandFontSizeMd}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style x:Key="BrandPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
    <Setter Property="MinHeight" Value="{StaticResource BrandInputHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource BrandRadiusSm}" />
    <Setter Property="FontFamily" Value="{StaticResource BrandFontBody}" />
    <Setter Property="FontSize" Value="{StaticResource BrandFontSizeMd}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource BrandTextBoxStyle}" />
  <Style TargetType="PasswordBox" BasedOn="{StaticResource BrandPasswordBoxStyle}" />

  <!-- ===== Surfaces ===== -->
  <!-- Card: white surface with a 1 px border on Chalk; on dark the surface with no border (BrandCardBorderBrush). No shadows. -->
  <Style x:Key="BrandCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource BrandSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BrandCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource BrandBorderThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource BrandRadiusLg}" />
    <Setter Property="Padding" Value="{StaticResource BrandPadding4}" />
  </Style>

  <!-- Stat tile: value in statM, caption below (radius md). -->
  <Style x:Key="BrandStatTileStyle" TargetType="Border" BasedOn="{StaticResource BrandCardStyle}">
    <Setter Property="CornerRadius" Value="{StaticResource BrandRadiusMd}" />
  </Style>

  <!-- Round header band: Fairway Ink (surfaceInverse on light, the dark surface on dark) with the score in statXL. -->
  <Style x:Key="BrandRoundHeaderBandStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrandPaletteInkBrush}" />
    <Setter Property="Padding" Value="20,16,20,20" />
  </Style>
  <Style x:Key="BrandRoundHeaderScoreStyle" TargetType="TextBlock" BasedOn="{StaticResource BrandTextStatXLStyle}">
    <Setter Property="Foreground" Value="{StaticResource BrandPaletteChalkBrush}" />
  </Style>
  <Style x:Key="BrandRoundHeaderLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BrandTextLabelStyle}">
    <Setter Property="Foreground" Value="{StaticResource BrandPaletteMistBrush}" />
  </Style>
  <!-- The hero number on dark may use Pin Orange itself (24 px bold and up). -->
  <Style x:Key="BrandRoundHeaderHighlightStyle" TargetType="TextBlock" BasedOn="{StaticResource BrandTextStatLStyle}">
    <Setter Property="Foreground" Value="{StaticResource BrandPaletteOrangeBrush}" />
  </Style>

  <!-- Notice / error banner shown by the app shell. -->
  <Style x:Key="BrandBannerStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource BrandSurfaceInverseBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource BrandRadiusSm}" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Margin" Value="12" />
  </Style>
  <Style x:Key="BrandBannerTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BrandTextCaptionStyle}">
    <Setter Property="Foreground" Value="{ThemeResource BrandTextInverseBrush}" />
  </Style>
</ResourceDictionary>
