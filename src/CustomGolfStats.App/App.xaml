<Application x:Class="CustomGolfStats.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Generated from brand/tokens/tokens.json (tools/generate-uno-theme.cs): colours (light/dark), fonts, sizes, text styles. -->
        <ResourceDictionary Source="ms-appx:///Themes/BrandTokens.xaml" />
        <!-- Hand-written control styles built only from the token resources. -->
        <ResourceDictionary Source="ms-appx:///Themes/BrandStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
