<Application x:Class="CustomGolfStats.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:CustomGolfStats.App.Views">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Generated from brand/tokens/tokens.json (tools/generate-uno-theme.cs): colours (light/dark), fonts, sizes, text styles. -->
        <ResourceDictionary Source="ms-appx:///Themes/BrandTokens.xaml" />
        <!-- Hand-written control styles built only from the token resources. -->
        <ResourceDictionary Source="ms-appx:///Themes/BrandStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Converters for {Binding} where a control's type differs from the view model's (NumberBox doubles, DatePicker offsets). -->
      <views:EnumTextConverter x:Key="EnumText" />
      <views:NumberBoxIntConverter x:Key="NumberBoxInt" />
      <views:NumberBoxDoubleConverter x:Key="NumberBoxDouble" />
      <views:DateConverter x:Key="DateOffset" />
      <views:NumberTextConverter x:Key="NumberText" />
    </ResourceDictionary>
  </Application.Resources>

</Application>
