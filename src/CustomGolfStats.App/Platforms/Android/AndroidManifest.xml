<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- One approximate reading for weather when a course has no coordinates. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <!-- Step counter for a round's steps (Android 10+). -->
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
  <uses-feature android:name="android.hardware.location.network" android:required="false" />

  <!-- No cloud backup: the secure store's key never leaves the device, so its ciphertext would be useless elsewhere. -->
  <application android:allowBackup="false"
               android:supportsRtl="true"
               android:networkSecurityConfig="@xml/network_security_config">
  </application>
</manifest>
