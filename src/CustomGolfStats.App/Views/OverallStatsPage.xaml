<local:RoutePage x:Class="CustomGolfStats.App.Views.OverallStatsPage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:CustomGolfStats.App.Views"
                 xmlns:stats="using:CustomGolfStats.Domain.Stats">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Padding="8,8,20,0" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Click="OnBack" Style="{StaticResource BrandIconButtonStyle}" AutomationProperties.Name="Back">
        <FontIcon Glyph="&#xE72B;" FontSize="18" />
      </Button>
      <TextBlock Grid.Column="1" Text="Stats" Style="{StaticResource BrandTextTitleStyle}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.Years}" SelectedItem="{Binding SelectedYear, Mode=TwoWay}" MinWidth="110"
                MinHeight="{StaticResource BrandInputHeight}" VerticalAlignment="Center" AutomationProperties.Name="Year" />
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="{StaticResource BrandScreenPadding}" Spacing="{StaticResource BrandSpace3}">
        <!-- Tiles -->
        <Grid ColumnSpacing="8" RowSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource BrandStatTileStyle}">
            <StackPanel>
              <TextBlock Text="{x:Bind ViewModel.ScoringAverage18Text, Mode=OneWay}" Style="{StaticResource BrandTextStatLStyle}" />
              <TextBlock Text="Scoring average (18 holes)" Style="{StaticResource BrandTextCaptionSecondaryStyle}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource BrandStatTileStyle}">
            <StackPanel>
              <TextBlock Text="{x:Bind local:Display.Handicap(ViewModel.HandicapIndex), Mode=OneWay}" Style="{StaticResource BrandTextStatLStyle}" />
              <TextBlock Text="Handicap index" Style="{StaticResource BrandTextCaptionSecondaryStyle}" />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource BrandStatTileStyle}">
            <StackPanel>
              <TextBlock Text="{x:Bind local:Display.Number(ViewModel.RoundsInYear), Mode=OneWay}" Style="{StaticResource BrandStatValueStyle}" />
              <TextBlock Text="Rounds" Style="{StaticResource BrandTextCaptionSecondaryStyle}" />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource BrandStatTileStyle}">
            <StackPanel>
              <TextBlock Text="{x:Bind ViewModel.ToParText, Mode=OneWay}" Style="{StaticResource BrandStatValueStyle}" />
              <TextBlock Text="{x:Bind local:OverallStatsPage.HolesText(ViewModel.Tiles), Mode=OneWay}" Style="{StaticResource BrandTextCaptionSecondaryStyle}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Season histograms -->
        <TextBlock Text="{x:Bind local:Ui.Label('18-hole scores')}" Style="{StaticResource BrandSectionLabelStyle}" />
        <ItemsControl ItemsSource="{x:Bind local:OverallStatsPage.Bars18(ViewModel.Season), Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:Bar">
              <Grid ColumnSpacing="8" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="96" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Style="{StaticResource BrandTextCaptionSecondaryStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Border Width="{x:Bind Width}" Height="20" CornerRadius="4" Background="{ThemeResource BrandPrimaryBrush}" />
                  <TextBlock Text="{x:Bind local:Display.Number(Count)}" Style="{StaticResource BrandTextStatSStyle}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{x:Bind local:Ui.Label('9-hole scores')}" Style="{StaticResource BrandSectionLabelStyle}" />
        <ItemsControl ItemsSource="{x:Bind local:OverallStatsPage.Bars9(ViewModel.Season), Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:Bar">
              <Grid ColumnSpacing="8" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="96" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Style="{StaticResource BrandTextCaptionSecondaryStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Border Width="{x:Bind Width}" Height="20" CornerRadius="4" Background="{ThemeResource BrandPrimaryBrush}" />
                  <TextBlock Text="{x:Bind local:Display.Number(Count)}" Style="{StaticResource BrandTextStatSStyle}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Round by round -->
        <TextBlock Text="{x:Bind local:Ui.Label('Rounds this year')}" Style="{StaticResource BrandSectionLabelStyle}" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Results}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="stats:SeasonResultRow">
              <Grid Padding="0,10" ColumnSpacing="8" BorderBrush="{ThemeResource BrandBorderBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Bind CourseName}" Style="{StaticResource BrandTextBodyStrongStyle}" />
                  <TextBlock Text="{x:Bind local:OverallStatsPage.ResultLine(PlayedOn, HoleCount, Putts, Gir)}" Style="{StaticResource BrandTextCaptionSecondaryStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock Text="{x:Bind local:Display.Number(Score)}" Style="{StaticResource BrandTextStatMStyle}" HorizontalAlignment="Right" />
                  <TextBlock Text="{x:Bind local:QuickHolePage.ToParText(ToPar)}" Style="{StaticResource BrandTextStatSStyle}" Foreground="{ThemeResource BrandTextSecondaryBrush}" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="No rounds in this year yet." Visibility="{x:Bind local:Ui.VisibleIfZero(ViewModel.RoundsInYear), Mode=OneWay}"
                   Style="{StaticResource BrandTextSecondaryStyle}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</local:RoutePage>
