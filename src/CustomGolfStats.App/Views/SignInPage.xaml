<local:RoutePage x:Class="CustomGolfStats.App.Views.SignInPage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:CustomGolfStats.App.Views">
  <!-- Route.SignIn: sign in / create account, the account-switch question, and a retry when the stored session could not be checked offline. -->
  <ScrollViewer>
    <Grid Padding="{StaticResource BrandScreenPadding}" MaxWidth="420">
      <StackPanel VerticalAlignment="Center" Spacing="{StaticResource BrandSpace4}">
        <Image Source="{ThemeResource BrandLockupStackedImage}" Height="132" HorizontalAlignment="Center" Margin="0,24,0,8" />
        <TextBlock Text="Track the stats nobody else thought to."
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Style="{StaticResource BrandTextSecondaryStyle}" />

        <!-- Sign in / create account form -->
        <StackPanel Spacing="{StaticResource BrandSpace3}" Visibility="{x:Bind local:Ui.CollapsedIfSet(ViewModel.PendingSwitch), Mode=OneWay}">
          <TextBlock Text="{x:Bind local:Ui.Label('Email')}" Style="{StaticResource BrandTextLabelStyle}" Foreground="{ThemeResource BrandTextSecondaryBrush}" />
          <TextBox InputScope="EmailSmtpAddress"
                   PlaceholderText="you@example.com"
                   Text="{x:Bind ViewModel.Email, Mode=TwoWay}"
                   AutomationProperties.Name="Email" />
          <TextBlock Text="{x:Bind local:Ui.Label('Password')}" Style="{StaticResource BrandTextLabelStyle}" Foreground="{ThemeResource BrandTextSecondaryBrush}" />
          <PasswordBox Password="{x:Bind ViewModel.Password, Mode=TwoWay}" AutomationProperties.Name="Password" />
          <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.VisibleIfSet(ViewModel.ErrorMessage), Mode=OneWay}"
                     Style="{StaticResource BrandTextErrorStyle}" />
          <Button Content="Try again" Click="OnRetryVerify" Style="{StaticResource BrandSecondaryButtonStyle}"
                  Visibility="{x:Bind local:SignInPage.OfflineRetryVisibility(ViewModel.ErrorMessage), Mode=OneWay}" />
          <Button Content="{x:Bind local:SignInPage.SubmitText(ViewModel.IsRegisterMode), Mode=OneWay}"
                  Command="{x:Bind ViewModel.SubmitCommand}"
                  Style="{StaticResource BrandHeroButtonStyle}"
                  Margin="0,8,0,0" />
          <Button Content="{x:Bind local:SignInPage.ToggleText(ViewModel.IsRegisterMode), Mode=OneWay}"
                  Command="{x:Bind ViewModel.ToggleModeCommand}"
                  Style="{StaticResource BrandLinkButtonStyle}" />
        </StackPanel>

        <!-- A different account signed in while this device holds unsynced data -->
        <Border Style="{StaticResource BrandCardStyle}" Visibility="{x:Bind local:Ui.VisibleIfSet(ViewModel.PendingSwitch), Mode=OneWay}">
          <StackPanel Spacing="{StaticResource BrandSpace3}">
            <TextBlock Text="Unsynced rounds on this device" Style="{StaticResource BrandTextHeadingStyle}" />
            <TextBlock Text="{x:Bind ViewModel.PendingSwitchMessage, Mode=OneWay}" Style="{StaticResource BrandTextBodyStyle}" />
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       Visibility="{x:Bind local:Ui.VisibleIfSet(ViewModel.ErrorMessage), Mode=OneWay}"
                       Style="{StaticResource BrandTextErrorStyle}" />
            <Button Content="Remove them and continue" Command="{x:Bind ViewModel.ConfirmAccountSwitchCommand}" Style="{StaticResource BrandPrimaryButtonStyle}" />
            <Button Content="Keep them and sign out" Command="{x:Bind ViewModel.CancelAccountSwitchCommand}" Style="{StaticResource BrandSecondaryButtonStyle}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</local:RoutePage>
