<local:RoutePage x:Class="CustomGolfStats.App.Views.RoundPage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:CustomGolfStats.App.Views"
                 xmlns:vm="using:CustomGolfStats.App.Core.ViewModels">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Round header band: Fairway Ink, score in statXL, to-par as the one accent number -->
    <Border Style="{StaticResource BrandRoundHeaderBandStyle}" Padding="8,8,20,20">
      <StackPanel Spacing="4">
        <Grid ColumnSpacing="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Click="OnBack" Style="{StaticResource BrandIconButtonStyle}" Background="Transparent"
                  Foreground="{StaticResource BrandPaletteChalkBrush}" AutomationProperties.Name="Back">
            <FontIcon Glyph="&#xE72B;" FontSize="18" />
          </Button>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind ViewModel.CourseName, Mode=OneWay}" Style="{StaticResource BrandTextHeadingStyle}"
                       Foreground="{StaticResource BrandPaletteChalkBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <TextBlock Text="{x:Bind local:Display.TeeLine(ViewModel.TeeName, ViewModel.PlayedOn), Mode=OneWay}" Style="{StaticResource BrandRoundHeaderLabelStyle}" />
          </StackPanel>
        </Grid>
        <Grid Margin="12,8,0,0" ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{x:Bind local:Ui.Label('Score')}" Style="{StaticResource BrandRoundHeaderLabelStyle}" />
            <TextBlock Text="{x:Bind local:Display.Score(ViewModel.TotalScore), Mode=OneWay}" Style="{StaticResource BrandRoundHeaderScoreStyle}" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,6">
            <TextBlock Text="{x:Bind ViewModel.ToParText, Mode=OneWay}" Style="{StaticResource BrandRoundHeaderHighlightStyle}" />
            <TextBlock Text="{x:Bind local:Display.Thru(ViewModel.HolesPlayed), Mode=OneWay}" Style="{StaticResource BrandRoundHeaderLabelStyle}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="{StaticResource BrandScreenPadding}" Spacing="{StaticResource BrandSpace2}">
        <TextBlock Text="{x:Bind local:Ui.Label('Holes')}" Style="{StaticResource BrandSectionLabelStyle}" Margin="0" />
        <TextBlock Text="No holes yet. Add the first one below."
                   Visibility="{x:Bind local:Ui.VisibleIfZero(ViewModel.HolesPlayed), Mode=OneWay}"
                   Style="{StaticResource BrandTextSecondaryStyle}" />
        <ListView ItemsSource="{x:Bind ViewModel.Holes}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnHoleClick"
                  ItemContainerStyle="{StaticResource BrandListItemStyle}" ScrollViewer.VerticalScrollMode="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:HoleListItem">
              <Border Style="{StaticResource BrandCardStyle}" Padding="12,8,4,8">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind local:Display.Number(HoleNumber)}" Style="{StaticResource BrandTextStatLStyle}" HorizontalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind local:RoundPage.HoleLine(Par, Putts)}" Style="{StaticResource BrandTextBodyStyle}" />
                    <TextBlock Text="{x:Bind local:RoundPage.HoleFlags(Gir, FairwayHit, ShotCount, IsDerived)}" Style="{StaticResource BrandTextCaptionSecondaryStyle}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind local:Display.Score(Score)}" Style="{StaticResource BrandTextStatMStyle}" HorizontalAlignment="Right" />
                    <TextBlock Text="{x:Bind ToParText}" Style="{StaticResource BrandTextStatSStyle}" Foreground="{ThemeResource BrandTextSecondaryBrush}" HorizontalAlignment="Right" />
                  </StackPanel>
                  <Button Grid.Column="3" Click="OnDeleteHole" Style="{StaticResource BrandIconButtonStyle}" AutomationProperties.Name="Delete hole">
                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource BrandTextSecondaryBrush}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Visibility="{x:Bind local:Ui.VisibleIfSet(ViewModel.ErrorMessage), Mode=OneWay}"
                   Style="{StaticResource BrandTextErrorStyle}" />
      </StackPanel>
    </ScrollViewer>

    <!-- Actions within thumb reach -->
    <Border Grid.Row="2" Padding="20,8,20,12" Background="{ThemeResource BrandBackgroundBrush}" BorderBrush="{ThemeResource BrandBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnSpacing="8" RowSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button Content="{x:Bind local:Display.AddHoleText(ViewModel.SuggestedHoleNumber), Mode=OneWay}" Click="OnAddSuggested"
                Style="{StaticResource BrandAccentButtonStyle}" MinHeight="{StaticResource BrandButtonHeightLarge}" />
        <Button Grid.Column="1" Content="Other hole" Style="{StaticResource BrandSecondaryButtonStyle}" MinHeight="{StaticResource BrandButtonHeightLarge}">
          <Button.Flyout>
            <MenuFlyout x:Name="OtherHoleMenu" Placement="Top" />
          </Button.Flyout>
        </Button>
        <Button Grid.Row="1" Grid.ColumnSpan="2" Content="Finish round" Command="{x:Bind ViewModel.FinishRoundCommand}"
                Visibility="{x:Bind local:Ui.CollapsedIf(ViewModel.IsFinished), Mode=OneWay}" Style="{StaticResource BrandPrimaryButtonStyle}" />
        <Button Grid.Row="1" Grid.ColumnSpan="2" Content="Round summary" Command="{x:Bind ViewModel.OpenSummaryCommand}"
                Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.IsFinished), Mode=OneWay}" Style="{StaticResource BrandPrimaryButtonStyle}" />
      </Grid>
    </Border>
  </Grid>
</local:RoutePage>
