<local:RoutePage x:Class="CustomGolfStats.App.Views.ScorecardPage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:CustomGolfStats.App.Views">
  <!-- Placeholder for Route.Scorecard (Task 4). The real screen arrives in Task 5; the bindings show the view model wiring. -->
  <ScrollViewer>
    <StackPanel Padding="{StaticResource BrandScreenPadding}" Spacing="{StaticResource BrandSpace4}">
      <Button Content="Back" Click="OnBack" HorizontalAlignment="Left" Style="{StaticResource BrandLinkButtonStyle}" Padding="0" />
      <TextBlock Text="Scorecard" Style="{StaticResource BrandTextTitleStyle}" />
      <TextBlock Text="{x:Bind local:Ui.Label('Placeholder screen')}" Style="{StaticResource BrandTextLabelStyle}" Foreground="{ThemeResource BrandTextSecondaryBrush}" />
      <StackPanel Spacing="{StaticResource BrandSpace3}">
      </StackPanel>
      <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 Visibility="{x:Bind local:Ui.VisibleIfSet(ViewModel.ErrorMessage), Mode=OneWay}"
                 Style="{StaticResource BrandTextErrorStyle}" />
    </StackPanel>
  </ScrollViewer>
</local:RoutePage>
