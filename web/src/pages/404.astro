---
import AppLayout from '../layouts/AppLayout.astro';
import PublicLayout from '../layouts/PublicLayout.astro';

Astro.response.status = 404;
const Layout = Astro.locals.session ? AppLayout : PublicLayout;
---

<Layout title="Not found">
  <div class="container page">
    <div class="page-header">
      <h1 class="display">Out of bounds</h1>
      <p class="lede">There’s no page at this address. Check the link, or head back to your stats.</p>
    </div>
    <p><a class="btn btn-primary" href="/stats">Go to your stats</a></p>
  </div>
</Layout>
