---
import PublicLayout from '../layouts/PublicLayout.astro';
import { formatAverage, formatInteger, formatPercent, formatToPar } from '../lib/format';

const signedIn = Astro.locals.session !== null;

// A sample front nine to show what a scored round looks like. Not user data.
const holes = [
  { n: 1, par: 4, score: 4 },
  { n: 2, par: 4, score: 5 },
  { n: 3, par: 3, score: 3 },
  { n: 4, par: 5, score: 4 },
  { n: 5, par: 4, score: 4 },
  { n: 6, par: 4, score: 5 },
  { n: 7, par: 3, score: 3 },
  { n: 8, par: 4, score: 4 },
  { n: 9, par: 5, score: 6 },
];
const par = holes.reduce((t, h) => t + h.par, 0);
const strokes = holes.reduce((t, h) => t + h.score, 0);
const mark = (h: { par: number; score: number }) =>
  h.score <= h.par - 2 ? 'eagle' : h.score === h.par - 1 ? 'birdie' : h.score === h.par + 1 ? 'bogey' : h.score >= h.par + 2 ? 'double' : 'par';
const sample = [
  { label: 'Fairways', value: '4/7', detail: formatPercent((4 / 7) * 100) },
  { label: 'Greens', value: '5/9', detail: formatPercent((5 / 9) * 100) },
  { label: 'Putts', value: formatInteger(15), detail: `${formatAverage(15 / 9)} per hole` },
];
---

<PublicLayout>
  <section class="hero container">
    <div class="hero-copy">
      <h1 class="display-xl">Track the stats nobody else thought to.</h1>
      <p class="lede">
        Every round you play, scored hole by hole: fairways, greens, putts, up-and-downs, and the numbers only you care about. Season by
        season, course by course.
      </p>
      <div class="hero-actions">
        {
          signedIn ? (
            <a class="btn btn-primary btn-hero" href="/stats">Go to your stats</a>
          ) : (
            <>
              <a class="btn btn-primary btn-hero" href="/sign-up">Create an account</a>
              <a class="btn btn-secondary btn-hero" href="/sign-in">Sign in</a>
            </>
          )
        }
      </div>
    </div>

    <figure class="card scorecard" aria-labelledby="sample-caption">
      <figcaption id="sample-caption" class="scorecard-head">
        <span class="heading">Front nine</span>
        <span class="caption">Sample round</span>
      </figcaption>
      <div class="table-wrap">
        <table class="score-grid">
          <thead>
            <tr>
              <th scope="col" class="label">Hole</th>
              {holes.map((h) => <th scope="col" class="num">{h.n}</th>)}
              <th scope="col" class="label total">Out</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="label">Par</th>
              {holes.map((h) => <td class="num">{h.par}</td>)}
              <td class="num total">{par}</td>
            </tr>
            <tr>
              <th scope="row" class="label">Score</th>
              {
                holes.map((h) => (
                  <td class="num">
                    <span class={`score score-${mark(h)}`}>{h.score}</span>
                  </td>
                ))
              }
              <td class="num total strong">{strokes}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="scorecard-foot">
        <dl class="sample-stats">
          {
            sample.map((s) => (
              <div>
                <dt class="label">{s.label}</dt>
                <dd>
                  <span class="stat stat-m">{s.value}</span>
                  <span class="caption num">{s.detail}</span>
                </dd>
              </div>
            ))
          }
        </dl>
        <div class="to-par">
          <span class="label">To par</span>
          <span class="stat stat-xl">{formatToPar(strokes - par)}</span>
        </div>
      </div>
      <p class="legend caption">
        <span class="score score-birdie" aria-hidden="true">4</span> birdie
        <span class="score score-bogey" aria-hidden="true">5</span> bogey
      </p>
    </figure>
  </section>

  <section class="container features" aria-labelledby="features-title">
    <h2 id="features-title" class="title">Everything a scorecard can tell you</h2>
    <ul>
      <li>
        <h3 class="heading">Scoring, tee to green</h3>
        <p>Off the tee, approach and around the green, and putting, by round and by season.</p>
      </li>
      <li>
        <h3 class="heading">Handicap history</h3>
        <p>Log your index as it moves and see every season’s trend in one place.</p>
      </li>
      <li>
        <h3 class="heading">Your courses</h3>
        <p>Find a course and its tees in the course database, or enter one yourself.</p>
      </li>
    </ul>
  </section>
</PublicLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-16) var(--space-12);
  }
  .hero-copy { display: grid; gap: var(--space-6); }
  .hero-copy h1 { max-width: 11ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .scorecard { margin: 0; padding: var(--space-6); display: grid; gap: var(--space-5); }
  .scorecard-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); }

  .score-grid { width: 100%; border-collapse: collapse; }
  .score-grid th, .score-grid td { padding: var(--space-2) 0; text-align: center; border-bottom: 1px solid var(--color-border); }
  .score-grid thead th.num { font-family: var(--font-mono); font-size: 12px; font-weight: 500; color: var(--color-text-secondary); }
  .score-grid th[scope='row'], .score-grid thead th:first-child { text-align: left; padding-right: var(--space-3); }
  .score-grid tbody tr:last-child th, .score-grid tbody tr:last-child td { border-bottom: 0; }
  .score-grid td { font-size: 15px; }
  .score-grid .total { padding-left: var(--space-3); border-left: 1px solid var(--color-border); }
  .score-grid .strong { font-weight: 700; }

  .score {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    border: 1.5px solid transparent;
  }
  .score-birdie, .score-eagle { border-color: var(--color-text); border-radius: 50%; }
  .score-bogey, .score-double { border-color: var(--color-text-secondary); border-radius: 3px; }
  .score-double { outline: 1.5px solid var(--color-text-secondary); outline-offset: 2px; }

  .scorecard-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .sample-stats { display: flex; flex-wrap: wrap; gap: var(--space-6); margin: 0; }
  .sample-stats dd { display: grid; gap: var(--space-1); margin: var(--space-2) 0 0; }
  .to-par { display: grid; justify-items: end; gap: var(--space-2); }
  /* The number that matters: the accent, as orange text that is legible in both themes. */
  .to-par .stat { color: var(--color-accent-text); }

  .legend { display: flex; align-items: center; gap: var(--space-2); }
  .legend .score { width: 22px; height: 22px; font-size: 12px; color: var(--color-text); }
  .legend .score-bogey { margin-left: var(--space-3); }

  .features { padding-block: var(--space-12) var(--space-16); border-top: 1px solid var(--color-border); display: grid; gap: var(--space-8); }
  .features ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-8); margin: 0; padding: 0; list-style: none; }
  .features li { display: grid; gap: var(--space-2); align-content: start; }
  .features p { color: var(--color-text-secondary); max-width: 32em; }

  @media (max-width: 960px) {
    .hero { grid-template-columns: minmax(0, 1fr); padding-block: var(--space-10); gap: var(--space-10); }
    .features ul { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  }
  @media (max-width: 480px) {
    .scorecard { padding: var(--space-4); }
    .score { width: 24px; height: 24px; }
    .score-grid td { font-size: 14px; }
    .to-par { justify-items: start; }
  }
</style>
