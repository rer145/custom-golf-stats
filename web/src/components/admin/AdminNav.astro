---
import { ADMIN_SECTIONS } from '../../lib/admin';

/** Sub-navigation for the admin area. */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href === '/admin' ? path === href : path === href || path.startsWith(`${href}/`));
---

<nav class="admin-nav" aria-label="Admin">
  <ul>
    {
      ADMIN_SECTIONS.map((s) => (
        <li>
          <a href={s.href} aria-current={isCurrent(s.href) ? 'page' : undefined}>
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .admin-nav { margin-bottom: var(--space-6); border-bottom: 1px solid var(--color-border); }
  ul { display: flex; flex-wrap: wrap; gap: 0 var(--space-1); margin: 0; padding: 0; list-style: none; }
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    color: var(--color-text-secondary);
    font-weight: 500;
    text-decoration: none;
  }
  a:hover { color: var(--color-text); }
  a[aria-current='page'] { color: var(--color-text); box-shadow: inset 0 -2px 0 var(--color-primary); }
</style>
